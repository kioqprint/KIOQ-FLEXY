rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'customer'
        && request.resource.data.keys().hasOnly(['name', 'phone', 'role', 'createdAt']);
      allow read: if request.auth != null
        && (request.auth.uid == userId
          || request.auth.token.email == 'kioq.store@gmail.com');
      allow update: if request.auth != null
        && request.auth.uid == userId
        && resource.data.role == 'customer'
        && request.resource.data.role == 'customer'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone']);
      allow delete: if false;
    }
  }
}