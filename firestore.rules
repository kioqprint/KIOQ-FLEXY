rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'kioq.store@gmail.com';
    }

    // Public app content: everyone can read, only the administrator can change it.
    match /app_config/{configId} {
      allow read: if configId == 'main';
      allow create, update, delete: if isAdmin() && configId == 'main';
    }

    match /announcements/{announcementId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'message', 'active', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.active is bool;
      allow update, delete: if isAdmin();
    }

    // Customer profiles are disabled; this app no longer creates customer accounts.
    match /users/{userId} {
      allow read, write: if false;
    }
  }
}